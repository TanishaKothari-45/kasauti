{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-lc", "cd web && source $HOME/.nvm/nvm.sh && nvm use >/dev/null && npm run dev -- -p 3000"],
      "port": 3000
    },
    {
      "name": "agent",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "voice_agent.server:app", "--reload", "--port", "7860"],
      "port": 7860
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "uvicorn", "clinic_api.main:app", "--reload", "--port", "8000"],
      "port": 8000
    }
  ]
}
