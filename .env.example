# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://kasauti:kasauti@localhost:5432/clinic

# Which voice stack the agent runs: local | sarvam
VOICE_STACK=local

# LLM (free tiers). Get a Gemini key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=

# Sarvam: only needed for the week-3 stack benchmark
SARVAM_API_KEY=

# Tracing (Langfuse free tier)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Service URLs
CLINIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLINIC_API_URL=http://localhost:8000
NEXT_PUBLIC_VOICE_AGENT_URL=http://localhost:7860
